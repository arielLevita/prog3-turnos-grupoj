{
    "components": {
        "schemas": {
            "MedicoInput": {
                "type": "object",
                "required": [
                    "idUsuario",
                    "idEspecialidad",
                    "matricula",
                    "valorConsulta"
                ],
                "properties": {
                    "idUsuario": {
                        "type": "integer",
                        "description": "ID del usuario asociado a este médico."
                    },
                    "idEspecialidad": {
                        "type": "integer",
                        "description": "ID de la especialidad del médico."
                    },
                    "matricula": {
                        "type": "integer",
                        "description": "Número de matrícula profesional."
                    },
                    "descripcion": {
                        "type": "string",
                        "description": "Información adicional (ej. días de atención)."
                    },
                    "valorConsulta": {
                        "type": "number",
                        "format": "float",
                        "description": "Costo de la consulta particular."
                    }
                },
                "example": {
                    "idUsuario": 1,
                    "idEspecialidad": 2,
                    "matricula": 12345,
                    "descripcion": "Atiende lunes y miércoles",
                    "valorConsulta": 12000.50
                }
            },
            "MedicoResponse": {
                "type": "object",
                "properties": {
                    "idMedico": {
                        "type": "integer"
                    },
                    "idUsuario": {
                        "type": "integer"
                    },
                    "documento": {
                        "type": "string"
                    },
                    "apellido": {
                        "type": "string"
                    },
                    "nombres": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "idEspecialidad": {
                        "type": "integer"
                    },
                    "especialidadNombre": {
                        "type": "string"
                    },
                    "matricula": {
                        "type": "integer"
                    },
                    "descripcion": {
                        "type": "string"
                    },
                    "valorConsulta": {
                        "type": "number",
                        "format": "float"
                    }
                },
                "example": {
                    "idMedico": 1,
                    "idUsuario": 1,
                    "documento": "20123456",
                    "apellido": "Perez",
                    "nombres": "Juan",
                    "email": "dr.perez@correo.com",
                    "idEspecialidad": 2,
                    "especialidadNombre": "CARDIOLOGÍA",
                    "matricula": 12345,
                    "descripcion": "Atiende lunes y miércoles",
                    "valorConsulta": 12000.50
                }
            },
            "AsignarObrasSocialesInput": {
                "type": "object",
                "required": [
                    "obras_sociales"
                ],
                "properties": {
                    "obras_sociales": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "description": "Array con los IDs de las obras sociales a asociar."
                    }
                },
                "example": {
                    "obras_sociales": [
                        1,
                        3,
                        5
                    ]
                }
            }
        }
    },
    "paths": {
        "/api/v2/medicos": {
            "get": {
                "summary": "Obtiene la lista de médicos (con datos de usuario y especialidad)",
                "tags": [
                    "Médicos"
                ],
                "responses": {
                    "200": {
                        "description": "Lista de médicos obtenida con éxito.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/MedicoResponse"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Registra un nuevo médico",
                "tags": [
                    "Médicos"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/MedicoInput"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Médico creado con éxito.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MedicoResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v2/medicos/{id_medico}": {
            "get": {
                "summary": "Obtiene un médico por ID",
                "tags": [
                    "Médicos"
                ],
                "parameters": [
                    {
                        "name": "id_medico",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Médico encontrado.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MedicoResponse"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Actualiza datos de un médico",
                "tags": [
                    "Médicos"
                ],
                "parameters": [
                    {
                        "name": "id_medico",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/MedicoInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Médico modificado con éxito.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MedicoResponse"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "summary": "Borrado lógico (Desactiva al usuario)",
                "tags": [
                    "Médicos"
                ],
                "parameters": [
                    {
                        "name": "id_medico",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Médico eliminado con éxito."
                    }
                }
            }
        },
        "/api/v2/medicos/{id_medico}/obras-sociales": {
            "post": {
                "summary": "Asocia múltiples obras sociales a un médico",
                "tags": [
                    "Médicos"
                ],
                "parameters": [
                    {
                        "name": "id_medico",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/AsignarObrasSocialesInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Obras sociales asociadas correctamente."
                    }
                }
            }
        },
        "/api/v2/medicos/{id_medico}/obras-sociales/{id_obra_social}": {
            "delete": {
                "summary": "Desasocia una obra social de un médico",
                "tags": [
                    "Médicos"
                ],
                "parameters": [
                    {
                        "name": "id_medico",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "id_obra_social",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Obra social desasociada correctamente."
                    }
                }
            }
        }
    }
}