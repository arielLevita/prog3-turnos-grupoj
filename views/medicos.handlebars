<h2 class="page-title">Directorio Médico</h2>
<p class="page-subtitle">Lista del personal médico activo</p>

<div class="table-container">
    {{#if medicos.length}}
    <table>
        <thead>
            <tr>
                <th>Matrícula</th>
                <th>Nombre Completo</th>
                <th>Especialidad</th>
                <th>Contacto</th>
                <th>Valor Consulta</th>
            </tr>
        </thead>
        <tbody>
            {{#each medicos}}
            <tr>
                <td><strong>{{this.matricula}}</strong></td>
                <td>Dr/a. {{this.apellido}}, {{this.nombres}}</td>
                <td><span class="badge badge-done">{{this.especialidadNombre}}</span></td>
                <td>{{this.email}}</td>
                <td class="price">$ {{this.valorConsulta}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    {{else}}
        <div class="empty-state">
            <h3>No hay médicos registrados.</h3>
        </div>
    {{/if}}
</div>
