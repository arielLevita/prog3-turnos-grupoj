<div class="card shadow-sm" style="width: 100%; max-width: 400px;">
    <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
            <h2 class="fw-bold">🏥 Clínica</h2>
            <p class="text-muted">Ingresá a tu cuenta</p>
        </div>

        {{#if error}}
        <div class="alert alert-danger text-center" role="alert">
            {{error}}
        </div>
        {{/if}}

        <form action="/auth/login" method="POST">
            <div class="mb-3">
                <label for="email" class="form-label fw-semibold">Correo Electrónico</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="ejemplo@correo.com"
                    required>
            </div>

            <div class="mb-4">
                <label for="contrasenia" class="form-label fw-semibold">Contraseña</label>
                <input type="password" class="form-control" id="contrasenia" name="contrasenia" placeholder="********"
                    required>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold">Iniciar Sesión</button>
        </form>
    </div>
</div>