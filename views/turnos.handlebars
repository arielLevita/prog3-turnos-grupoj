<h2 class="page-title">Gestión de Turnos</h2>
<p class="page-subtitle">Visualización del registro histórico y turnos pendientes (Renderizado SSR)</p>

<div class="table-container">
    {{#if turnos.length}}
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Fecha y Hora</th>
                <th>Paciente</th>
                <th>Médico</th>
                <th>Obra Social</th>
                <th>Valor Total</th>
            </tr>
        </thead>
        <tbody>
            {{#each turnos}}
            <tr>
                <td>#{{this.idTurnoReserva}}</td>
                <!-- Utilizamos un helper de Handlebars o simplemente lo mostramos -->
                <td>{{this.fechaHora}}</td>
                <td><strong>{{this.pacienteNombre}}</strong></td>
                <td>Dr. {{this.medicoNombre}}</td>
                <td><span class="badge badge-info">{{this.obraSocialNombre}}</span></td>
                <td class="price">$ {{this.valorTotal}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    {{else}}
        <div class="empty-state">
            <h3>No hay turnos registrados en el sistema.</h3>
        </div>
    {{/if}}
</div>
