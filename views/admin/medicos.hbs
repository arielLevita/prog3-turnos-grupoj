<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Plantel Médico</h2>
    <a href="/admin/medicos/nuevo" class="btn btn-primary fw-bold">+ Nuevo Médico</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Matrícula</th>
                        <th>Nombre Completo</th>
                        <th>Especialidad</th>
                        <th>Valor Consulta</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each medicos}}
                    <tr>
                        <td class="fw-bold">{{this.matricula}}</td>
                        <td>{{this.nombres}} {{this.apellido}}</td>
                        <td><span class="badge bg-info text-dark">{{this.especialidad_nombre}}</span></td>
                        <td>${{this.valor_consulta}}</td>
                        <td>
                            {{#if this.activo}}
                            <span class="badge bg-success">Activo</span>
                            {{else}}
                            <span class="badge bg-danger">Inactivo</span>
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>