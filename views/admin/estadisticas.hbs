<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Estadísticas de Atenciones</h2>
    <a href="/admin/estadisticas/pdf" class="btn btn-danger fw-bold" target="_blank">📄 Descargar Informe PDF</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Médico</th>
                        <th>Especialidad</th>
                        <th class="text-center">Turnos Atendidos</th>
                        <th class="text-end">Recaudación Total</th>
                    </tr>
                </thead>
                <tbody>
                    {{#if estadisticas.length}}
                    {{#each estadisticas}}
                    <tr>
                        <td class="fw-bold">{{this.medico_nombre}}</td>
                        <td><span class="badge bg-secondary">{{this.especialidad}}</span></td>
                        <td class="text-center">{{this.total_turnos}}</td>
                        <td class="text-end text-success fw-bold">
                            ${{this.recaudacion_total}}
                        </td>
                    </tr>
                    {{/each}}
                    {{else}}
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No hay datos estadísticos disponibles
                            todavía.</td>
                    </tr>
                    {{/if}}
                </tbody>
            </table>
        </div>
    </div>
</div>