<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clínica - Sistema de Turnos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Navbar genérica (tus compañeros quizás la cambiaron) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4 shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🏥 Clínica Integrada</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">
                    {{#if usuario}}
                        <li class="nav-item">
                            <span class="nav-link text-white me-3">Hola, {{usuario.nombre}} (Rol: {{usuario.rol}})</span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-light btn-sm mt-1 fw-bold" href="/api/v2/auth/logout">Cerrar Sesión</a>
                        </li>
                    {{else}}
                        <li class="nav-item">
                            <a class="nav-link" href="/login">Iniciar Sesión</a>
                        </li>
                    {{/if}}
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-3">
        {{#if mensajeExito}}
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                ✅ {{mensajeExito}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{/if}}

        {{#if mensajeError}}
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                ❌ {{mensajeError}}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {{/if}}
    </div>

    {{{body}}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
